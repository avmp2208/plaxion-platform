{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "plaxion-platform Helm values",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "database"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "aspnetcore": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["Development", "Testing", "Staging", "Production"]
        },
        "urls": { "type": "string" }
      }
    },
    "authentication": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowAnonymousProduction": { "type": "boolean" },
        "oidc": {
          "type": "object",
          "properties": {
            "authority": { "type": "string" },
            "audience": { "type": "string" },
            "requireHttpsMetadata": { "type": "boolean" },
            "dashboard": {
              "type": "object",
              "properties": {
                "clientId": { "type": "string" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "redirectPath": { "type": "string" },
                "postLogoutRedirectPath": { "type": "string" }
              }
            }
          }
        },
        "authorization": {
          "type": "object",
          "properties": {
            "tenantCreation": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["AnyAuthenticatedUser", "Role", "Claim"]
                },
                "requiredRole": { "type": "string" },
                "requiredClaimType": { "type": "string" },
                "requiredClaimValues": { "type": "array", "items": { "type": "string" } }
              },
              "allOf": [
                {
                  "if": { "properties": { "mode": { "const": "Role" } }, "required": ["mode"] },
                  "then": { "required": ["requiredRole"], "properties": { "requiredRole": { "type": "string", "minLength": 1 } } }
                },
                {
                  "if": { "properties": { "mode": { "const": "Claim" } }, "required": ["mode"] },
                  "then": { "required": ["requiredClaimType"], "properties": { "requiredClaimType": { "type": "string", "minLength": 1 } } }
                }
              ]
            },
            "platformAdministrator": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["Disabled", "Role", "Claim"]
                },
                "requiredRole": { "type": "string" },
                "requiredClaimType": { "type": "string" },
                "requiredClaimValues": { "type": "array", "items": { "type": "string" } }
              },
              "allOf": [
                {
                  "if": { "properties": { "mode": { "const": "Role" } }, "required": ["mode"] },
                  "then": { "required": ["requiredRole"], "properties": { "requiredRole": { "type": "string", "minLength": 1 } } }
                },
                {
                  "if": { "properties": { "mode": { "const": "Claim" } }, "required": ["mode"] },
                  "then": { "required": ["requiredClaimType"], "properties": { "requiredClaimType": { "type": "string", "minLength": 1 } } }
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "oidc": {
                "type": "object",
                "required": ["authority", "audience"],
                "properties": {
                  "authority": { "type": "string", "minLength": 1 },
                  "audience": { "type": "string", "minLength": 1 },
                  "dashboard": {
                    "type": "object",
                    "required": ["clientId"],
                    "properties": {
                      "clientId": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "ingressRoute": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ingestion": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["mode", "provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["PostgreSql"]
        },
        "mode": {
          "type": "string",
          "enum": ["external", "bundled"]
        },
        "external": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "passwordKey": { "type": "string" }
              }
            },
            "existingConnectionStringSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "external" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "external": {
                "type": "object",
                "anyOf": [
                  {
                    "properties": {
                      "existingConnectionStringSecret": {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": { "type": "string", "minLength": 1 }
                        }
                      }
                    },
                    "required": ["existingConnectionStringSecret"]
                  },
                  {
                    "required": ["host", "database", "username"],
                    "properties": {
                      "host": { "type": "string", "minLength": 1 },
                      "database": { "type": "string", "minLength": 1 },
                      "username": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    }
  }
}
